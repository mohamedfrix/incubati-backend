# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/application_service

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# gRPC Configuration (for future implementation)
GRPC_PORT=50051

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# CORS Configuration
CORS_ORIGINS=*

# Logging Configuration
LOG_LEVEL=info

# Minio/S3 Configuration
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_REGION=us-east-1
MINIO_USE_SSL=false

# Minio Bucket Configuration
MINIO_DOCUMENTS_BUCKET=documents
MINIO_TEMP_BUCKET=temp-files

# Download URL Configuration
MINIO_DOWNLOAD_URL_EXPIRY_SECONDS=3600
