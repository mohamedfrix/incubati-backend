### Scenario 4: Multi-User Query and Management
### ============================================

### Step 4.1: Create applications for different users
# @name multiUserScenario_CreateApp1
POST {{baseUrl}}/api/applications
Content-Type: {{contentType}}

{
    "user_id": "user-alpha",
    "application_type": "internship",
    "status": "en_attente",
    "type": "Internship",
    "data": {
        "company": "Alpha Corp",
        "position": "Software Engineer Intern",
        "duration_months": 6,
        "start_date": "2025-09-01"
    }
}

###

# @name multiUserScenario_CreateApp2
POST {{baseUrl}}/api/applications
Content-Type: {{contentType}}

{
    "user_id": "user-beta",
    "application_type": "incubation",
    "status": "approuvee",
    "type": "Incubation",
    "data": {
        "project_name": "Beta Startup",
        "business_model": "B2C Platform",
        "target_market": "Consumers",
        "team_size": 3,
        "project_stage": "Launch"
    }
}

###

# @name multiUserScenario_CreateApp3
POST {{baseUrl}}/api/applications
Content-Type: {{contentType}}

{
    "user_id": "user-gamma",
    "application_type": "pfe",
    "status": "rejetee",
    "type": "Pfe",
    "data": {
        "title": "Gamma Research Project",
        "supervisor_name": "Prof. Gamma",
        "academic_year": "2024-2025",
        "specialization": "Data Science",
        "objectives": "Research project objectives"
    }
}

###

### Step 4.2: Query all applications
# @name multiUserScenario_QueryAll
GET {{baseUrl}}/api/applications
Accept: {{contentType}}

###

### Step 4.3: Query by type
# @name multiUserScenario_QueryByType
GET {{baseUrl}}/api/applications?application_type=internship
Accept: {{contentType}}

###

### Step 4.4: Query by status
# @name multiUserScenario_QueryByStatus
GET {{baseUrl}}/api/applications?status=approuvee
Accept: {{contentType}}

###

### Step 4.5: Query by user
# @name multiUserScenario_QueryByUser
GET {{baseUrl}}/api/applications?user_id=user-alpha
Accept: {{contentType}}

###

### Step 4.6: Complex query with pagination
# @name multiUserScenario_ComplexQuery
GET {{baseUrl}}/api/applications?application_type=internship&status=en_attente&page=1&limit=5
Accept: {{contentType}}

