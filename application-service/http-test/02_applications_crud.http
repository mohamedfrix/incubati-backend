### 3. Create PFE Application - Valid
# @name createPfeApp
POST {{baseUrl}}/api/applications
Content-Type: {{contentType}}

{
    "user_id": "{{testUserId}}",
    "application_type": "Pfe",
    "status": "Brouillon",
    "type": "Pfe",
    "data": {
        "title": "Machine Learning for Predictive Maintenance",
        "supervisor_name": "Dr. Sarah Johnson",
        "company": "Industrial Solutions Inc",
        "academic_year": "2024-2025",
        "specialization": "Computer Science - AI",
        "objectives": "Develop ML models for predictive maintenance in industrial equipment",
        "methodology": "Data collection, feature engineering, model training and validation",
        "expected_outcomes": "Working prototype with 85% accuracy in failure prediction"
    }
}

###

### 4. Get Application by ID - Valid (use ID from previous create)
# @name getApplicationById
@applicationId = 466c4f90-dc86-44f5-bd3e-6934d218df98
GET {{baseUrl}}/api/applications/{{applicationId}}
Accept: {{contentType}}

###

### 5. Update Application - Valid
# @name updateApplication
@applicationId = 3b0f01f1-f4c5-40dc-8222-580351313c1b
PUT {{baseUrl}}/api/applications/{{applicationId}}
Content-Type: {{contentType}}

{
    "user_id": "{{testUserId}}",
    "application_type": "Internship",
    "status": "Brouillon",
    "type": "Internship",
    "data": {
        "company": "TechCorp Solutions (Updated)",
        "position": "Senior Software Developer Intern",
        "duration_months": 8,
        "start_date": "2025-09-01",
        "supervisor_name": "John Smith",
        "supervisor_email": "john.smith@techcorp.com",
        "description": "Updated: Full-stack development internship with focus on microservices",
        "requirements": "Updated: Advanced JavaScript, React, Node.js, Docker knowledge required"
    }
}

###

### 6. Delete Application - Valid
# @name deleteApplication
@applicationId = 3b0f01f1-f4c5-40dc-8222-580351313c1b
DELETE {{baseUrl}}/api/applications/{{applicationId}}

###

### 7. Get Deleted Application - Should Return 404
# @name getDeletedApplication
@applicationId = 3b0f01f1-f4c5-40dc-8222-580351313c1b
GET {{baseUrl}}/api/applications/{{applicationId}}
Accept: {{contentType}}

