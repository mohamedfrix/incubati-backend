### 10. Update Non-Existent Application
# @name updateNonExistentApp
@nonExistentId = 00000000-0000-0000-0000-000000000000
PUT {{baseUrl}}/api/applications/{{nonExistentId}}
Content-Type: {{contentType}}

{
    "user_id": "{{testUserId}}",
    "application_type": "internship",
    "status": "brouillon",
    "type": "Internship",
    "data": {
        "company": "NonExistent Corp",
        "position": "Developer",
        "duration_months": 6,
        "start_date": "2025-09-01"
    }
}

