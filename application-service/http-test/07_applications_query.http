### Application Query, Filtering, and Pagination Tests

@baseUrl = http://localhost:8080
@contentType = application/json
@testUserId1 = query-test-user-1
@testUserId2 = query-test-user-2
@testUserId3 = query-test-user-3

### Setup: Create multiple test applications for querying
# @name createQueryTestApp1
POST {{baseUrl}}/api/applications
Content-Type: {{contentType}}

{
    "user_id": "{{testUserId1}}",
    "application_type": "internship",
    "status": "brouillon",
    "type": "Internship",
    "data": {
        "company": "Query Test Corp A",
        "position": "Junior Developer",
        "duration_months": 6,
        "start_date": "2025-09-01"
    }
}

###

# @name createQueryTestApp2
POST {{baseUrl}}/api/applications
Content-Type: {{contentType}}

{
    "user_id": "{{testUserId1}}",
    "application_type": "incubation",
    "status": "en_attente",
    "type": "Incubation",
    "data": {
        "project_name": "Query Test Project A",
        "business_model": "SaaS Platform",
        "target_market": "SMBs",
        "team_size": 3,
        "project_stage": "MVP"
    }
}

###

