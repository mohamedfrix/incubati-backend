POST {{baseUrl}}/api/applications
Content-Type: {{contentType}}

{
    "user_id": "{{testUserId3}}",
    "application_type": "incubation",
    "status": "modification_demandee",
    "type": "Incubation",
    "data": {
        "project_name": "Query Test Project B",
