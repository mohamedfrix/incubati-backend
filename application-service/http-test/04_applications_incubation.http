### 15. Update Existing Incubation Application
# @name updateIncubationApp
@incubationId = use-id-from-create-response
PUT {{baseUrl}}/api/applications/{{incubationId}}
Content-Type: {{contentType}}

{
    "user_id": "{{testUserId}}",
    "application_type": "incubation",
    "status": "brouillon",
    "type": "Incubation",
    "data": {
        "project_name": "Updated EcoSmart Platform",
        "business_model": "Updated business model with new revenue streams",
        "target_market": "Expanded target market including new segments",
        "funding_amount": 200000.00,
        "team_size": 7,
        "project_stage": "Product Launch",
        "description": "Updated description with latest project developments and milestones"
    }
}

