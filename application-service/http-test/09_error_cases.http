### 13. Invalid Date Formats
# @name invalidDateFormats
POST {{baseUrl}}/api/applications
Content-Type: {{contentType}}

{
    "user_id": "{{testUserId}}",
    "application_type": "internship",
    "status": "brouillon",
    "type": "Internship",
    "data": {
        "company": "Invalid Date Corp",
        "position": "Date Tester",
        "duration_months": 6,
        "start_date": "32/13/2025"
    }
}

###

### 14. SQL Injection Attempt in Text Fields
# @name sqlInjectionAttempt
POST {{baseUrl}}/api/applications
Content-Type: {{contentType}}

{
    "user_id": "'; DROP TABLE applications; --",
    "application_type": "internship",
    "status": "brouillon",
    "type": "Internship",
    "data": {
        "company": "'; DELETE FROM applications WHERE 1=1; --",
        "position": "' OR '1'='1",
        "duration_months": 6,
        "start_date": "2025-09-01",
        "supervisor_email": "'; INSERT INTO applications (user_id) VALUES ('hacker'); --"
    }
}

###

### 15. XSS Attempt in Text Fields
# @name xssAttempt
POST {{baseUrl}}/api/applications
Content-Type: {{contentType}}

{
    "user_id": "{{testUserId}}",
    "application_type": "internship",
    "status": "brouillon",
    "type": "Internship",
    "data": {
        "company": "<script>alert('XSS')</script>",
        "position": "<img src='x' onerror='alert(1)'>",
        "duration_months": 6,
        "start_date": "2025-09-01",
        "description": "<iframe src='javascript:alert(\"XSS\")'></iframe>",
        "requirements": "<svg onload='alert(1)'>"
    }
}

###

