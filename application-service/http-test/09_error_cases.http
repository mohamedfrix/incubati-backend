### 26. Mixed Type Values
# @name mixedTypeValues
POST {{baseUrl}}/api/applications
Content-Type: {{contentType}}

{
    "user_id": 12345,
    "application_type": true,
    "status": ["brouillon"],
    "type": {"Internship": "value"},
    "data": "This should be an object"
}

###

### 27. Recursive/Circular JSON Structure
# @name recursiveJsonStructure
POST {{baseUrl}}/api/applications
Content-Type: {{contentType}}

{
    "user_id": "{{testUserId}}",
    "application_type": "internship",
    "status": "brouillon",
    "type": "Internship",
    "data": {
        "company": "Recursive Corp",
        "position": "Recursion Tester",
        "duration_months": 6,
        "start_date": "2025-09-01",
        "nested": {
            "level1": {
                "level2": {
                    "level3": {
                        "level4": {
                            "level5": "Deep nesting test"
                        }
                    }
                }
            }
        }
    }
}

