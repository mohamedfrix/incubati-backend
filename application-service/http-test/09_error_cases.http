### 34. Request Timeout Simulation (Long Processing)
# This would be simulated by the server if it has such endpoints
# @name timeoutSimulation
POST {{baseUrl}}/api/applications
Content-Type: {{contentType}}

{
    "user_id": "{{testUserId}}",
    "application_type": "internship",
    "status": "brouillon",
    "type": "Internship",
    "data": {
        "company": "Timeout Test Corp",
        "position": "Timeout Tester",
        "duration_months": 6,
        "start_date": "2025-09-01",
        "description": "This request simulates a long processing time to test timeout handling"
    }
}

