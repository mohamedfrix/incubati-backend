### 8. Create PFE Application - Very Long Text Fields
# @name createLongTextPfe
POST {{baseUrl}}/api/applications
Content-Type: {{contentType}}

{
    "user_id": "{{testUserId}}",
    "application_type": "pfe",
    "status": "brouillon",
    "type": "Pfe",
    "data": {
        "title": "Comprehensive Multi-Modal Machine Learning System for Advanced Natural Language Processing and Computer Vision Integration with Real-Time Analytics",
        "supervisor_name": "Professor Dr. Very Long Supervisor Name With Multiple Academic Titles And Research Specializations",
        "company": "Very Long Company Name That Specializes In Advanced Technology Solutions And Research Development",
        "academic_year": "2024-2025",
        "specialization": "Computer Science - Multi-Modal AI and Advanced Machine Learning Systems",
        "objectives": "Develop a comprehensive multi-modal machine learning system that integrates natural language processing, computer vision, and real-time analytics capabilities to solve complex business problems across multiple domains including healthcare, finance, manufacturing, and education. The system should demonstrate advanced capabilities in understanding and processing diverse data types, providing intelligent insights, and supporting decision-making processes with high accuracy and reliability.",
        "methodology": "The methodology includes comprehensive literature review of current multi-modal AI systems, detailed requirements analysis with industry stakeholders, design of novel neural network architectures combining transformers and convolutional networks, implementation of advanced training strategies including transfer learning and multi-task learning, development of real-time processing pipelines using distributed computing frameworks, extensive testing with diverse datasets, performance evaluation using multiple metrics, comparison with state-of-the-art systems, and thorough documentation of findings and recommendations.",
        "expected_outcomes": "The expected outcomes include a fully functional multi-modal AI system with demonstrated capabilities across multiple domains, comprehensive evaluation results showing performance improvements over existing systems, detailed technical documentation including architecture specifications and implementation guidelines, research publications in top-tier conferences and journals, open-source software libraries for community use, industry partnerships for real-world deployment, and recommendations for future research directions in multi-modal AI systems."
    }
}

