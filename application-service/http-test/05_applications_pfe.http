### 15. Update Existing PFE Application
# @name updatePfeApp
@pfeId = use-id-from-create-response
PUT {{baseUrl}}/api/applications/{{pfeId}}
Content-Type: {{contentType}}

{
    "user_id": "{{testUserId}}",
    "application_type": "pfe",
    "status": "brouillon",
    "type": "Pfe",
    "data": {
        "title": "Updated: Advanced Medical Image Analysis with Enhanced AI",
        "supervisor_name": "Dr. Maria Elena Rodriguez (Updated)",
        "company": "MedTech Solutions Inc (Updated)",
        "academic_year": "2024-2025",
        "specialization": "Computer Science - Advanced AI & Medical Imaging",
        "objectives": "Updated objectives: Develop enhanced deep learning models with improved accuracy and real-time processing capabilities",
        "methodology": "Updated methodology: Include latest AI techniques, advanced preprocessing, and clinical validation protocols",
        "expected_outcomes": "Updated outcomes: Enhanced prototype with 98% accuracy, real-time processing, clinical deployment readiness"
    }
}

