### PFE (Final Year Project) Applications - Comprehensive Tests

@baseUrl = http://localhost:8080
@contentType = application/json
@testUserId = test-user-pfe

### 1. Create PFE Application - Complete Data
# @name createFullPfe
POST {{baseUrl}}/api/applications
Content-Type: {{contentType}}

{
    "user_id": "{{testUserId}}",
    "application_type": "pfe",
    "status": "brouillon",
    "type": "Pfe",
    "data": {
        "title": "Deep Learning for Medical Image Analysis in Cancer Detection",
        "supervisor_name": "Dr. Maria Elena Rodriguez",
        "company": "MedTech Solutions Inc",
        "academic_year": "2024-2025",
        "specialization": "Computer Science - Artificial Intelligence",
        "objectives": "Develop and implement deep learning models for automated cancer detection in medical imaging, focusing on CT scans and MRI images with 95% accuracy target",
        "methodology": "Literature review, dataset collection and preprocessing, CNN architecture design, model training with transfer learning, validation with clinical data, comparative analysis with existing methods",
        "expected_outcomes": "Functional prototype with trained models, accuracy benchmarks, clinical validation results, research paper publication, and deployable software system"
    }
}

