### 13. Create Internship Application - Special Characters in Text
# @name createSpecialCharsInternship
POST {{baseUrl}}/api/applications
Content-Type: {{contentType}}

{
    "user_id": "{{testUserId}}",
    "application_type": "internship",
    "status": "brouillon",
    "type": "Internship",
    "data": {
        "company": "Spëcïål Çhäräctërs Corp™",
        "position": "Software Developer & AI Engineer (Full-Stack)",
        "duration_months": 6,
        "start_date": "2025-09-01",
        "supervisor_name": "José María García-Rodriguez",
        "supervisor_email": "jose.maria@specialchars.com",
        "description": "Work with special characters: éàèùâêîôûç, emojis: 🚀💻🎯, and symbols: @#$%^&*()+=[]{}|;:'\",.<>?/~`",
        "requirements": "Unicode support, UTF-8 encoding, special characters handling: αβγδε, 中文, العربية, русский"
    }
}

###

### 14. Update Existing Internship Application
# @name updateInternshipApp
@internshipId = use-id-from-create-response
PUT {{baseUrl}}/api/applications/{{internshipId}}
Content-Type: {{contentType}}

{
    "user_id": "{{testUserId}}",
    "application_type": "internship",
    "status": "brouillon",
    "type": "Internship",
    "data": {
        "company": "Updated Company Name",
        "position": "Updated Position Title",
        "duration_months": 9,
        "start_date": "2025-10-01",
        "supervisor_name": "Updated Supervisor",
        "supervisor_email": "updated@company.com",
        "description": "Updated description with new information",
        "requirements": "Updated requirements and qualifications"
    }
}

###
