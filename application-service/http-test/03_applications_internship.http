### 12. Create Internship Application - Very Long Text Fields
# @name createLongTextInternship
POST {{baseUrl}}/api/applications
Content-Type: {{contentType}}

{
    "user_id": "{{testUserId}}",
    "application_type": "internship",
    "status": "brouillon",
    "type": "Internship",
    "data": {
        "company": "Very Long Company Name That Exceeds Normal Limits And Tests Field Length Validation Systems",
        "position": "Very Long Position Title That Tests The Maximum Length Allowed For Position Names In The System",
        "duration_months": 6,
        "start_date": "2025-09-01",
        "supervisor_name": "Very Long Supervisor Name That Tests The Maximum Length Allowed For Supervisor Names",
        "supervisor_email": "very.long.email.address.that.tests.maximum.length@very.long.domain.name.example.com",
        "description": "This is a very long description that tests the maximum length allowed for description fields in the system. It contains detailed information about the internship, including objectives, daily tasks, learning outcomes, project details, team structure, company culture, technology stack, development methodologies, and expected deliverables. The description continues to provide comprehensive information about the internship opportunity to test field length validation.",
        "requirements": "This is a very long requirements field that tests the maximum length allowed for requirements in the system. It includes detailed technical requirements, educational background, programming languages, frameworks, tools, soft skills, experience levels, certifications, portfolio requirements, and other qualifications needed for the internship position."
    }
}

