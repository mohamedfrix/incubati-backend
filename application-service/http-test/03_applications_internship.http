### Internship Applications - Comprehensive Tests

@baseUrl = http://localhost:4001
@contentType = application/json
@testUserId = test-user-internship

### 1. Create Internship Application - Complete Data
# @name createFullInternship
POST {{baseUrl}}/api/applications
Content-Type: {{contentType}}

{
    "user_id": "{{testUserId}}",
    "application_type": "Internship",
    "status": "Brouillon",
    "type": "Internship",
    "data": {
        "company": "Google Inc",
        "position": "Software Engineering Intern",
        "duration_months": 12,
        "start_date": "2025-06-01",
        "supervisor_name": "Jane Doe",
        "supervisor_email": "jane.doe@google.com",
        "description": "Work on large-scale distributed systems, contribute to open-source projects, and learn from senior engineers in a collaborative environment.",
        "requirements": "Strong programming skills in Python/Java, understanding of algorithms and data structures, experience with version control systems"
    }
}

