### Document Management - Upload, Download, and Management Tests

@baseUrl = http://localhost:4001
@contentType = application/json
@multipartType = multipart/form-data
@testUserId = document-test-user

### Test files (create these files in test_files/ directory for actual testing)
@testPdfFile = test_files/sample_document.pdf
@testImageFile = test_files/sample_image.jpg
@testTextFile = test_files/sample_text.txt
@largePdfFile = test_files/large_document.pdf

### Setup: Create test application for document uploads
# @name createAppForDocuments
POST {{baseUrl}}/api/applications
Content-Type: {{contentType}}

{
    "user_id": "{{testUserId}}",
    "application_type": "internship",
    "status": "brouillon",
    "type": "Internship",
    "data": {
        "company": "Document Test Corp",
        "position": "Document Manager",
        "duration_months": 6,
        "start_date": "2025-09-01",
        "supervisor_name": "Doc Supervisor",
        "supervisor_email": "docs@testcorp.com",
        "description": "Application for testing document management",
        "requirements": "Document handling skills"
    }
}

@documentTestAppId = use-id-from-response

###

### 1. Upload PDF Document - Valid
# @name uploadValidPdf
POST {{baseUrl}}/api/applications/{{documentTestAppId}}/documents
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="file"; filename="resume.pdf"
Content-Type: application/pdf

%PDF-1.4
1 0 obj
<<
/Type /Catalog
/Pages 2 0 R
>>
endobj
2 0 obj
<<
/Type /Pages
/Kids [3 0 R]
/Count 1
>>
endobj
3 0 obj
<<
/Type /Page
/Parent 2 0 R
/MediaBox [0 0 612 792]
/Contents 4 0 R
>>
endobj
4 0 obj
<<
/Length 44
>>
stream
BT
/F1 12 Tf
72 720 Td
(Sample PDF Document) Tj
ET
endstream
endobj
xref
0 5
0000000000 65535 f 
0000000009 00000 n 
0000000058 00000 n 
0000000115 00000 n 
0000000208 00000 n 
trailer
<<
/Size 5
/Root 1 0 R
>>
startxref
296
%%EOF
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="document_type"

resume
------WebKitFormBoundary7MA4YWxkTrZu0gW--

###

### 2. Upload Image Document - Valid
