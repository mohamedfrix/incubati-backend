### Prerequisites:
# 1. Run auth-nginx.http tests first to get tokens
# 2. Run applications-nginx.http tests to create applications  
# 3. Update the variables above with actual values from previous tests
# 4. Have actual files ready for upload testing

### Health Check
GET {{baseUrl}}/documents/health

### 1. Upload CV Document - Valid
POST {{baseUrl}}/documents
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary123456789
Authorization: Bearer {{student_token}}

------WebKitFormBoundary123456789
Content-Disposition: form-data; name="application_id"

{{applicationId}}
------WebKitFormBoundary123456789
Content-Disposition: form-data; name="title"

CV Document
------WebKitFormBoundary123456789
Content-Disposition: form-data; name="file"; filename="cv.pdf"
Content-Type: application/pdf

%PDF-1.4
1 0 obj
<<
/Type /Catalog
/Pages 2 0 R
>>
endobj
2 0 obj
<<
/Type /Pages
/Kids [3 0 R]
/Count 1
>>
endobj
3 0 obj
<<
/Type /Page
/Parent 2 0 R
/MediaBox [0 0 612 792]
/Contents 4 0 R
>>
endobj
4 0 obj
<<
/Length 44
>>
stream
BT
/F1 12 Tf
72 720 Td
(Test CV Document) Tj
ET
endstream
endobj
xref
0 5
0000000000 65535 f 
0000000009 00000 n 
0000000058 00000 n 
0000000115 00000 n 
0000000204 00000 n 
trailer
<<
/Size 5
/Root 1 0 R
>>
startxref
297
%%EOF
------WebKitFormBoundary123456789--

